@@ -349,6 +349,30 @@ static UIImage *SDL_LoadLaunchImageNamed(NSString *name, int screenh)
 
 @end
 
+/* UIKit's scene life cycle, which an app built with the iOS 27 SDK must use (it exits at launch otherwise): the
+ * scene the app's windows go in, once UIKit connects it. */
+UIWindowScene *SDL_UIKit_windowScene API_AVAILABLE(ios(13.0)) = nil;
+
+API_AVAILABLE(ios(13.0))
+@interface SDLUIKitSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@end
+
+@implementation SDLUIKitSceneDelegate
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        SDL_UIKit_windowScene = (UIWindowScene *)scene;
+    }
+}
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == SDL_UIKit_windowScene) {
+        SDL_UIKit_windowScene = nil;
+    }
+}
+/* (the app's own UIApplication notifications still come, which SDL's events follow) */
+@end
+
 @implementation SDLUIKitDelegate {
     UIWindow *launchWindow;
 }
@@ -388,12 +412,28 @@ static UIImage *SDL_LoadLaunchImageNamed(NSString *name, int screenh)
     }];
 }
 
+- (UISceneConfiguration *)application:(UIApplication *)application
+    configurationForConnectingSceneSession:(UISceneSession *)session
+                                   options:(UISceneConnectionOptions *)options API_AVAILABLE(ios(13.0))
+{
+    UISceneConfiguration *config = [[UISceneConfiguration alloc] initWithName:@"SDL" sessionRole:session.role];
+    config.delegateClass = [SDLUIKitSceneDelegate class];
+    return config;
+}
+
 - (void)postFinishLaunch
 {
     /* Hide the launch screen the next time the run loop is run. SDL apps will
      * have a chance to load resources while the launch screen is still up. */
     [self performSelector:@selector(hideLaunchScreen) withObject:nil afterDelay:0.0];
 
+    /* The windows go in the app's scene: wait for UIKit to connect it */
+    if (@available(iOS 13.0, *)) {
+        for (int i = 0; i < 200 && !SDL_UIKit_windowScene; i++) {
+            [[NSRunLoop currentRunLoop] runMode:NSDefaultRunLoopMode beforeDate:[NSDate dateWithTimeIntervalSinceNow:0.025]];
+        }
+    }
+
     /* run the user's application, passing argc and argv */
     SDL_iPhoneSetEventPump(SDL_TRUE);
     exit_status = forward_main(forward_argc, forward_argv);
