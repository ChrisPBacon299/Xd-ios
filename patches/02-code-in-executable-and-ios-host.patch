+/* iOS (COLO_IOS): the app around the port's main (main.c, built as colo_port_main there).
+ *
+ * SDL's UIKit app delegate starts it once UIKit has the app's scene (SDL is patched for the scene life cycle an app
+ * built with the iOS 27 SDK must use). Before the game starts:
+ * - the files: the app's Documents folder (Files: On My iPhone > the app) is the game folder. The disc is the first
+ *   .iso or .gcm there whose header is this game's (GC6E01 or GXXE01); saves go in Documents/Saves, crash reports and
+ *   state in Library, and the game's own log in Documents/log.txt, to share when something goes wrong;
+ * - the settings: Metal, 4:3 (the game's own shape), 60 fps, 2x internal resolution and 16x texture filtering,
+ *   unless set already. */
+#ifdef COLO_IOS
+#import <UIKit/UIKit.h>
+#include <SDL.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include "game.h"
+
+extern int colo_port_main(int argc, char** argv);
+
+static void set_default(const char* name, const char* value) { setenv(name, value, 0); }
+
+/* a disc image of this game: the six bytes at its start are the game's id */
+static int is_this_game(NSString* path)
+{
+    FILE* f = fopen(path.fileSystemRepresentation, "rb");
+    if (!f) return 0;
+    char id[6] = {0};
+    size_t n = fread(id, 1, 6, f);
+    fclose(f);
+    return n == 6 && !memcmp(id, GAME_ID, 6);
+}
+
+static NSString* find_disc(NSString* docs)
+{
+    NSFileManager* fm = [NSFileManager defaultManager];
+    NSDirectoryEnumerator* e = [fm enumeratorAtPath:docs];
+    for (NSString* rel in e) {
+        NSString* ext = rel.pathExtension.lowercaseString;
+        if (![ext isEqualToString:@"iso"] && ![ext isEqualToString:@"gcm"]) continue;
+        NSString* path = [docs stringByAppendingPathComponent:rel];
+        if (is_this_game(path)) return path;
+    }
+    return nil;
+}
+
+static int run(int argc, char** argv)
+{
+    @autoreleasepool {
+        NSString* docs = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+        NSString* lib = NSSearchPathForDirectoriesInDomains(NSLibraryDirectory, NSUserDomainMask, YES).firstObject;
+        NSFileManager* fm = [NSFileManager defaultManager];
+        for (NSString* d in @[ [docs stringByAppendingPathComponent:@"Saves"], [docs stringByAppendingPathComponent:@"State"],
+                               [docs stringByAppendingPathComponent:@"mods"] ])
+            [fm createDirectoryAtPath:d withIntermediateDirectories:YES attributes:nil error:nil];
+
+        /* the game's log, for sharing from Files */
+        NSString* log = [docs stringByAppendingPathComponent:@"log.txt"];
+        freopen(log.fileSystemRepresentation, "w", stderr);
+        freopen(log.fileSystemRepresentation, "a", stdout);
+        setvbuf(stdout, NULL, _IOLBF, 0);
+        setvbuf(stderr, NULL, _IONBF, 0);
+        fprintf(stderr, "%s (%s) on iOS %s\n", GAME_NAME, GAME_ID, UIDevice.currentDevice.systemVersion.UTF8String);
+
+        setenv("XDG_DATA_HOME", [docs stringByAppendingPathComponent:@"Saves"].fileSystemRepresentation, 0);
+        /* (crash reports go in Documents/State/colo-port/crashes, to share from Files) */
+        setenv("XDG_STATE_HOME", [docs stringByAppendingPathComponent:@"State"].fileSystemRepresentation, 0);
+        chdir(docs.fileSystemRepresentation);   /* mods/, bindings.txt and rom/ are where the port looks for them */
+
+        set_default("SMS_GX_BACKEND", "metal");
+        set_default("SMS_GX_SCALE", "2");   /* 2x: about 1280x960, near 1080p, and cooler than 3x on a phone */
+        set_default("COLO_FPS", "60");
+        set_default("COLO_WIDESCREEN", "4:3");
+        set_default("SMS_ANISO", "16");       /* sharp textures at an angle, as the PC version has them */
+
+        if (!getenv("COLO_DISC")) {
+            NSString* disc = find_disc(docs);
+            if (disc) setenv("COLO_DISC", disc.fileSystemRepresentation, 1);
+            else fprintf(stderr, "no %s disc image (.iso or .gcm) in the app's folder: put yours there in Files\n", GAME_ID);
+        }
+        fprintf(stderr, "disc: %s\n", getenv("COLO_DISC") ? getenv("COLO_DISC") : "(none)");
+    }
+    int r = colo_port_main(argc, argv);
+    fprintf(stderr, "the game ended (%d)\n", r);
+    return r;
+}
+
+int main(int argc, char** argv)
+{
+    SDL_SetHint(SDL_HINT_IOS_HIDE_HOME_INDICATOR, "2");
+    return SDL_UIKitRunApp(argc, argv, run);
+}
