+def link_ios(g, imports, exports, aliases, host_objs, gen_objs, link_objs):
+    """iOS: the executable of an app (Payload/<name>.app, made by the iOS workflow around it), SDL linked in."""
+    L, EXE = g['L'], g['EXE']
+    sdl = g['IOS_SDL']
+    frameworks = ['UIKit', 'Foundation', 'CoreGraphics', 'QuartzCore', 'Metal', 'AVFoundation', 'AudioToolbox', 'CoreAudio',
+                  'CoreMotion', 'CoreHaptics', 'GameController', 'CoreBluetooth', 'OpenGLES', 'CoreFoundation']
+    cmd = g['HOSTCXX'] + ['-o', EXE, '-Wl,-sectcreate,__COLO,__game,' + L + '/game.elf', '-Wl,-headerpad_max_install_names',
+                          '-Wl,-dead_strip_dylibs'] + \
+          ['-Wl,-alias,_%s,_%s' % a for a in aliases] + host_objs + gen_objs + link_objs + g['GX_LIBS'] + \
+          [sdl + '/lib/libSDL2.a'] + [x for f in frameworks for x in ('-framework', f)] + ['-liconv']
+    open(L + '/cmd.rsp', 'w').write(g['rsp'](cmd[len(g['HOSTCXX']):]))
+    r = subprocess.run(g['HOSTCXX'] + ['@' + L + '/cmd.rsp'], capture_output=True, text=True, errors='backslashreplace')
+    open(L + '/link.log', 'w').write(r.stderr)
+    print('game objs', len(g['objs']), 'imports', len(imports), 'exports', len(exports))
+    if r.returncode:
+        print('\n'.join([l for l in r.stderr.splitlines() if l.strip()][:80]))
+        raise SystemExit(1)
+    print('linked', EXE)
+    g['cache_report']()
+
