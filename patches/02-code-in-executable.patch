+#!/usr/bin/env python3
+"""a64abs.py UNIT.s: (arm64) make a game unit's assembly address its data absolutely.
+
+The game's code runs from the executable (iOS runs only signed code) while its data stays in the 4 GiB window, about
+444 GiB away: out of reach of adrp's +-4 GiB. A Darwin target is always position independent, so clang has no large
+code model for it (it would build each address with movz/movk). So the assembly is rewritten:
+
+* adrp xN, sym            ->  movz/movk xN, sym (all four 16-bit parts), then and xN, xN, ~0xFFF:
+                              the same page address, absolute, and the :lo12:sym users that follow stay as they are;
+* adrp xN, :got:sym       ->  movz/movk xN, sym: the address itself, absolute (no GOT entry), and
+  ldr xD, [xB, :got_lo12:sym] ->  mov xD, xB.
+
+An adrp to a label of this unit's code is left alone: code addressing code relatively moves with it. Anything else
+relative that reaches data, the link refuses with a list (tools/link_macos.py)."""
+import re, sys
+
+path = sys.argv[1]
+lines = open(path, encoding='utf-8', errors='surrogateescape').read().split('\n')
+
+# the labels this unit defines in code sections
+code_labels, section_code = set(), True
+sec_re = re.compile(r'^\s*\.(text|data|bss|section\s+([^,\s]+).*)\s*$')
+for l in lines:
+    m = sec_re.match(l)
+    if m:
+        name = m.group(2) or m.group(1)
+        section_code = name == 'text' or name.startswith('.text') or 'TEXT' in name
+        continue
+    lm = re.match(r'^([A-Za-z_.$][\w.$]*|"[^"]*"):', l)
+    if lm and section_code: code_labels.add(lm.group(1))
+
+adrp_re = re.compile(r'^(\s*)adrp\s+(x\d+),\s*(:got:)?(.+?)\s*(//.*)?$')
+gotld_re = re.compile(r'^(\s*)ldr\s+(x\d+),\s*\[(x\d+),\s*:got_lo12:(.+?)\]\s*(//.*)?$')
+
+def base_symbol(expr):
+    m = re.match(r'^([A-Za-z_.$][\w.$]*|"[^"]*")', expr)
+    return m.group(1) if m else None
+
+def absolute(ind, reg, expr):
+    return [f'{ind}movz\t{reg}, #:abs_g3:{expr}', f'{ind}movk\t{reg}, #:abs_g2_nc:{expr}',
+            f'{ind}movk\t{reg}, #:abs_g1_nc:{expr}', f'{ind}movk\t{reg}, #:abs_g0_nc:{expr}']
+
+out, changed = [], 0
+for l in lines:
+    m = adrp_re.match(l)
+    if m:
+        ind, reg, got, expr = m.group(1), m.group(2), m.group(3), m.group(4)
+        if base_symbol(expr) in code_labels and not got:
+            out.append(l); continue
+        out += absolute(ind, reg, expr)
+        if not got: out.append(f'{ind}and\t{reg}, {reg}, #0xfffffffffffff000')
+        changed += 1
+        continue
+    m = gotld_re.match(l)
+    if m:
+        ind, dst, base = m.group(1), m.group(2), m.group(3)
+        out.append(f'{ind}mov\t{dst}, {base}' if dst != base else f'{ind}// (the address is already in {base})')
+        changed += 1
+        continue
+    out.append(l)
+open(path, 'w', encoding='utf-8', errors='surrogateescape').write('\n'.join(out))
